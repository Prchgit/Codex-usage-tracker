{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-usage-tracker",
  "version": "0.3.1",
  "description": "Read local Codex chat usage, compare chats, inspect account limits, and open the usage dashboard inside Codex.",
  "author": {"name": "Prchgit"},
  "repository": "https://github.com/Prchgit/Codex-usage-tracker",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Codex Usage Tracker",
        "shortDescription": "Chat usage and account limits",
        "developerName": "Prchgit",
        "category": "Productivity",
        "capabilities": ["Read"],
        "defaultPrompt": ["Show my recent chat usage", "Compare usage across my chats", "Open my usage dashboard"]
      }
    }
  }
}
