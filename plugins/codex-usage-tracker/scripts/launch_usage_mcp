#!/usr/bin/python3
"""Launch the installed read-only server without depending on the repo checkout."""
import os
from pathlib import Path
import sys

runtime = Path(os.environ.get('CODEX_USAGE_TRACKER_RUNTIME_DIR') or Path.home() / '.local/share/codex-token-monitor').expanduser()
python = Path(os.environ.get('CODEX_USAGE_TRACKER_MCP_PYTHON') or runtime / 'mcp-venv/bin/python').expanduser()
runner = runtime / 'run_usage_mcp.py'
if not python.is_file() or not runner.is_file():
    print('Codex Usage Tracker plugin runtime missing. Run python3 scripts/install_plugin.py from the Codex Usage Tracker repository.',file=sys.stderr)
    raise SystemExit(1)
os.execv(str(python),[str(python),str(runner),'--runtime',str(runtime),*sys.argv[1:]])
